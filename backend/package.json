{
  "name": "resolvedesk-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "seed": "NODE_ENV=${NODE_ENV:-development} node src/seed.js",
    "simulate": "NODE_ENV=${NODE_ENV:-development} node src/simulate.js",
    "bootstrap-admin": "node src/bootstrapAdmin.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "train": "cd python && python3 train.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  }
}
